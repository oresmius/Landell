- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"\n    1st-order sigma-delta modulator (1-bit)\n    \"\"\"\n    def\
      \ __init__(self):\n        gr.sync_block.__init__(\n            self,\n    \
      \        name='sdm1',\n            in_sig=[np.float32],\n            out_sig=[np.float32],\n\
      \        )\n        self.acc = 0.0\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0]\n        y = output_items[0]\n\n        for n in\
      \ range(len(x)):\n            bit = 1.0 if self.acc >= 0.0 else 0.0\n      \
      \      self.acc += float(x[n]) - bit\n            y[n] = bit\n\n        return\
      \ len(y)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('sdm1', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)], '\n    1st-order
      sigma-delta modulator (1-bit)\n    ', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1096, 304.0]
    rotation: 0
    state: enabled
